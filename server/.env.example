# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องคุณ
PORT=3000

# ข้อมูลการต่อ PostgreSQL (ใส่รหัสผ่านที่ตั้งไว้ตอนติดตั้ง PostgreSQL)
DATABASE_URL=postgres://postgres:ใส่รหัสผ่านตรงนี้@localhost:5432/jodjodkub

# กุญแจเซ็น JWT - ตั้งเป็นข้อความสุ่มยาว ๆ ห้ามใช้ค่านี้ตอนใช้งานจริง
JWT_SECRET=change_me_to_a_long_random_string
