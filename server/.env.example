# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องคุณ
PORT=3000

# ข้อมูลการต่อ PostgreSQL (ใส่รหัสผ่านที่ตั้งไว้ตอนติดตั้ง PostgreSQL)
# ถ้าชี้ไปที่ฐานข้อมูลบนคลาวด์ ระบบจะเปิด SSL ให้อัตโนมัติ
DATABASE_URL=postgres://postgres:ใส่รหัสผ่านตรงนี้@localhost:5432/jodjodkub

# กุญแจเซ็น JWT - ต้องยาวอย่างน้อย 16 ตัวอักษร ไม่ตั้งเซิร์ฟเวอร์จะไม่ยอมสตาร์ท
# สุ่มค่าได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ความกว้างภาพก่อนส่งเข้า OCR (ไม่ใส่ = 1600)
# ยิ่งใหญ่ยิ่งอ่านแม่นแต่กินแรมมาก เซิร์ฟเวอร์แรมน้อยลองลดเหลือ 1000-1200
# OCR_WIDTH=1200
